<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="15dp"
    tools:context=".Create_account_Password">

    <TextView
        android:id="@+id/Password_title_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_password"
        android:textSize="32sp"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.25"
        />

    <TextView
        android:id="@+id/Password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/password"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:fontFamily="@font/robot_condensed_family"
        android:textStyle="normal"
        app:layout_constraintTop_toBottomOf="@+id/Password_title_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="0dp"
        android:layout_marginTop="25dp"
        />

    <EditText
        android:id="@+id/Password_input"
        android:layout_width="240dp"
        android:layout_height="33dp"
        android:autofillHints="password"
        android:inputType="textPassword"
        android:paddingStart="15dp"
        android:text="@string/enter_password"
        android:textColor="@color/white"
        android:fontFamily="@font/robot_condensed_family"
        android:textStyle="normal"
        android:textSize="20sp"
        android:background="@drawable/light_green_box"
        app:layout_constraintTop_toBottomOf="@+id/Password"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="0dp"
        android:elevation="4dp"
        android:shadowColor="@color/darkGreen"
        tools:ignore="LabelFor,RtlSymmetry"
        />

    <TextView
        android:id="@+id/Confirm_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/confirm_password"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:fontFamily="@font/robot_condensed_family"
        android:textStyle="normal"
        app:layout_constraintTop_toBottomOf="@+id/Password_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="0dp"
        android:layout_marginTop="45dp"
        />

    <EditText
        android:id="@+id/Confirm_password_input"
        android:layout_width="240dp"
        android:layout_height="33dp"
        android:autofillHints="password"
        android:inputType="textPassword"
        android:paddingStart="15dp"
        android:text="@string/enter_password"
        android:textColor="@color/white"
        android:fontFamily="@font/robot_condensed_family"
        android:textStyle="normal"
        android:textSize="20sp"
        android:background="@drawable/light_green_box"
        app:layout_constraintTop_toBottomOf="@+id/Confirm_password"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="0dp"
        android:elevation="4dp"
        android:shadowColor="@color/darkGreen"
        tools:ignore="LabelFor,RtlSymmetry"
        />

    <Button
        android:id="@+id/Next_button"
        android:layout_width="93dp"
        android:layout_height="33dp"
        android:background="@drawable/light_green_box"
        android:text="@string/next"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:fontFamily="@font/robot_condensed_family"
        android:textStyle="normal"
        android:textAllCaps="false"
        android:elevation="4dp"
        android:shadowColor="@color/darkGreen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="2dp"
        />

    <Button
        android:id="@+id/back_button"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/back_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="0dp"
        />
</androidx.constraintlayout.widget.ConstraintLayout>